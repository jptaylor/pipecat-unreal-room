# Copy to .env (gitignored). The bot reads it from bot/; set variables win.
OPENAI_API_KEY=      # every character speaks with OpenAI...
CARTESIA_API_KEY=    # ...in their own voice, a TTS each
DEEPGRAM_API_KEY=    # speech to text (Flux)
JEV_API_KEY=         # Jev (TypeSafe): who you're talking to, and how everyone takes it
DAILY_API_KEY=       # with -t daily: the runner makes a Daily room for the game and the bot

# Optional
# OPENAI_MODEL=gpt-4.1-mini        # or gpt-5.6-luna (Luna), which answers without reasoning
# Or PhoneLLM, as the kitchen table has it, when all three are set:
# PHONELLM_API_KEY=
# PHONELLM_BASE_URL=   # its OpenAI-compatible endpoint, ending in /v1
# LLM_MODEL=
# LLM_REPETITION_PENALTY=1.05  # PhoneLLM only; 1.0 turns it off
# JEV_MODEL=jev-1.13.0
# BOT_LOG_LEVEL=INFO          # DEBUG adds what was said (INFO keeps it out of the logs)
